<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <groupId>com.himpact</groupId>
    <artifactId>himpact-backend</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>HImpact Backend</name>
    <description>HImpact Digital Event Automation Platform — Backend Service</description>

    <properties>
        <java.version>21</java.version>

        <!--
            Lombok 1.18.38 is the minimum version that supports Java 25.
            Lombok 1.18.34 (resolved by Spring Boot 3.3.2 BOM) uses internal javac APIs
            (sun.misc.Unsafe::objectFieldOffset, com.sun.tools.javac.code.TypeTag::UNKNOWN)
            that were removed in Java 25, causing ExceptionInInitializerError at compile time.
            We explicitly pin this property so both the dependency declaration and the
            annotationProcessorPaths entry in maven-compiler-plugin use the same version.
        -->
        <lombok.version>1.18.38</lombok.version>

        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.5.0</springdoc.version>
        <google.api.version>v3-rev20240628-2.0.0</google.api.version>
        <google.auth.version>1.23.0</google.auth.version>
        <zxing.version>3.5.3</zxing.version>

        <!--
            testcontainers.version is intentionally omitted.
            Spring Boot 3.3.2 BOM manages Testcontainers. Overriding it manually
            risks version mismatches between testcontainers modules.
        -->
    </properties>

    <dependencies>

        <!-- ── Spring Boot Core ───────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            spring-boot-starter-actuator declared once.
            Duplicate removed from "Monitoring" block — duplicate caused:
            [WARNING] 'dependencies.dependency.(groupId:artifactId:type:classifier)' must be unique
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── Security ──────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            spring-boot-starter-oauth2-resource-server REMOVED.
            The project implements its own JwtAuthenticationFilter with custom HImpact tokens.
            The resource-server auto-configuration conflicts: it creates a separate JWT decoder
            that attempts to resolve the issuer-uri (https://accounts.google.com) at startup,
            causing a startup failure in offline environments and conflicting security filter chain.
        -->

        <!-- ── Monitoring & Observability ────────────────────────────────── -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <!--
                runtime scope: application code never imports Micrometer registry classes.
                The registry is wired by Spring Boot auto-configuration at runtime only.
            -->
            <scope>runtime</scope>
        </dependency>

        <!-- ── Database ──────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <!--
                flyway-database-postgresql must be runtime scope.
                It is a Flyway plugin module loaded via ServiceLoader — application code
                never directly imports classes from this artifact.
            -->
            <scope>runtime</scope>
        </dependency>

        <!-- ── JWT ───────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ── Google APIs ───────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-drive</artifactId>
            <version>${google.api.version}</version>
        </dependency>

        <!--
            google-oauth-client-jetty REMOVED.
            This library provides a local redirect server for desktop OAuth flows.
            It is inappropriate for server-side applications and pulls in transitive
            Jetty dependencies that conflict with the embedded Tomcat.
            The project uses Service Account authentication via google-auth-library-oauth2-http
            which does not require a local redirect server.
        -->

        <dependency>
            <groupId>com.google.auth</groupId>
            <artifactId>google-auth-library-oauth2-http</artifactId>
            <version>${google.auth.version}</version>
        </dependency>

        <!-- ── Mapping ───────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- ── Utilities ─────────────────────────────────────────────────── -->
        <!--
            Lombok pinned to 1.18.38. The Spring Boot 3.3.2 BOM resolves 1.18.34,
            which is incompatible with Java 25 (causes TypeTag::UNKNOWN crash).
            optional=true ensures Lombok is excluded from the packaged JAR.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- ── API Documentation ─────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ── ZXing QR Code ─────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${zxing.version}</version>
        </dependency>

        <!-- ── Email ─────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ── Scheduling ────────────────────────────────────────────────── -->
        <!-- Included in spring-boot-starter — no extra dependency needed -->

        <!-- ── Testing ───────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers versions managed by Spring Boot BOM.
            Explicit testcontainers.version property removed — overriding the BOM
            version risks subtle incompatibilities between Testcontainers modules.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ── Dev Tools ─────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        <release> replaces the deprecated <source>/<target> pair.
                        release enforces both the source language level AND the
                        target bytecode version AND the bootstrap API classpath,
                        ensuring no Java 22+ APIs are accidentally used.
                    -->
                    <release>21</release>
                    <annotationProcessorPaths>
                        <!--
                            ORDER IS CRITICAL:
                            1. Lombok must run FIRST — it generates builder/getter/setter methods.
                            2. lombok-mapstruct-binding enforces the correct processor order.
                            3. mapstruct-processor must run AFTER Lombok so it can see
                               Lombok-generated methods (e.g., builder setters on entities).
                        -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
