# HImpact Local Development Environment
# Copy from .env.example and fill in your real values.
# NEVER commit this file to git (it is already in .gitignore).

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/HIMPACT_DB
SPRING_DATASOURCE_USERNAME=himpact_dev
SPRING_DATASOURCE_PASSWORD=hamdy

# JWT
JWT_SECRET=local-dev-secret-change-this-in-production-must-be-long-enough
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google OAuth2 - get from https://console.cloud.google.com -> Credentials -> OAuth 2.0 Client IDs
# Authorized origins: http://localhost:5173, http://localhost:8080
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# Google Drive API (leave blank for local dev)
GOOGLE_DRIVE_APPLICATION_NAME=HImpact
GOOGLE_DRIVE_CREDENTIALS_PATH=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (SMTP) - use a Gmail App Password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com

# Infrastructure
POSTGRES_DB=HIMPACT_DB
POSTGRES_USER=himpact_dev
POSTGRES_PASSWORD=hamdy
PGADMIN_DEFAULT_EMAIL=admin@himpact.app
PGADMIN_DEFAULT_PASSWORD=hamdy

# Google Drive Storage Provider
# Option A (local dev): point to your downloaded service-account JSON key file
GOOGLE_DRIVE_CREDENTIALS_PATH=C:\secure\himpact\himpact-drive.json

# Option B (Docker/prod): paste the full JSON content of the service-account key
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Drive root folder — shared with himpact-drive@enduring-honor-417612.iam.gserviceaccount.com
GOOGLE_DRIVE_ROOT_FOLDER_ID=1Zqz6Qfvfmjlmg6RoJfqSu0u3YoRgvIpN

# Application name shown in Google APIs Console
GOOGLE_DRIVE_APPLICATION_NAME=HImpact Digital Event Automation
