# ─── Backend ──────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/himpact
SPRING_DATASOURCE_USERNAME=himpact
SPRING_DATASOURCE_PASSWORD=changeme

# JWT
JWT_SECRET=replace-with-a-strong-256-bit-secret-key
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Drive API
GOOGLE_DRIVE_APPLICATION_NAME=HImpact
GOOGLE_DRIVE_CREDENTIALS_PATH=/secrets/google-drive-credentials.json

# CORS
CORS_ALLOWED_ORIGINS=https://yourusername.github.io,http://localhost:5173

# WhatsApp (future — leave blank until provider is approved)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SMS / OTP (provider TBD — e.g. Firebase, Twilio)
SMS_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_SERVER_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Infrastructure ───────────────────────────────────────────────────────────
POSTGRES_DB=himpact
POSTGRES_USER=himpact
POSTGRES_PASSWORD=changeme
PGADMIN_DEFAULT_EMAIL=admin@himpact.app
PGADMIN_DEFAULT_PASSWORD=changeme
